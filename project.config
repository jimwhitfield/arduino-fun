[access]
	inheritFrom = All-Projects
[access "refs/*"]
	owner = group user/jimwhitfield
[access "refs/for/refs/*"]
	read = group user/jimwhitfield
	push = group user/jimwhitfield
	label-Code-Review = -2..+2 group user/jimwhitfield
	label-Verified = -1..+1 group user/jimwhitfield
	rebase = group user/jimwhitfield
	removeReviewer = group user/jimwhitfield
	submit = group user/jimwhitfield
[access "refs/heads/*"]
	read = group user/jimwhitfield
	create = group user/jimwhitfield
	push = +force group user/jimwhitfield
	pushMerge = group user/jimwhitfield
[access "refs/tags/*"]
	push = +force group user/jimwhitfield
	pushTag = group user/jimwhitfield
	pushSignedTag = group user/jimwhitfield
